{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SSEEvent",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["stage_started", "stage_done", "token", "sample", "cluster", "verdict", "error"]
    },
    "stage": { "type": "string" },
    "t": { "type": "number" },
    "ms": { "type": "number" },
    "text": { "type": "string" },
    "payload": { "type": "object" },
    "verdict": { "type": "string" },
    "confidence": { "type": "number" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "message": { "type": "string" },
    "recoverable": { "type": "boolean" }
  }
}
