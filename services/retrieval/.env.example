# Environment configuration for BETA Retrieval Service
# Copy to .env for local development

# Security & Service Keys
ENVIRONMENT=development
INTERNAL_API_KEY=test-internal-key-12345
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["*"]

# Database Connections (Neon PostgreSQL with pgvector)
# Use pooled connection URL for standard app traffic, direct connection URL for migrations
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
QUANTIZATION_MODE=none  # options: none, int8, binary

# LLM Grounded-Correction Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_TOKENS=512

# Cache & Rate Limiting
CACHE_TTL_SECONDS=60
RATE_LIMIT_REQUESTS_PER_MINUTE=120
