# Copy to .env and fill in real values. Never commit .env.

# Provider credentials (placeholders only)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Sampling (used when a request includes a question)
BLACKBOX_OPENAI_MODEL=gpt-4o-mini
BLACKBOX_ANTHROPIC_MODEL=claude-haiku-5-5
BLACKBOX_SAMPLE_COUNT=5
BLACKBOX_TEMPERATURE=1.0
BLACKBOX_MAX_TOKENS=300

# Local models (downloaded from Hugging Face on first use)
BLACKBOX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BLACKBOX_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Decision thresholds (all in [0, 1]); defaults are untuned starting points
BLACKBOX_T_HIGH_CONSISTENCY=0.80
BLACKBOX_T_LOW_CONSISTENCY=0.50
BLACKBOX_T_STRONG_CONTRADICTION=0.80
BLACKBOX_T_MIN_SUPPORT=0.60
BLACKBOX_T_SINGLE_SIGNAL_CAP=0.75
