# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_replace_with_a_secure_32plus_char_random_string

# Path to the SQLite database file (defaults to ./beta_auth.db)
# DB_PATH=./beta_auth.db

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail example: use an App Password (not your login password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="BETA" <your-email@gmail.com>

# ── Other existing services ───────────────────────────────────────────────────
DATABASE_URL=
INTERPRETABILITY_SERVICE_URL=
BLACKBOX_SERVICE_URL=
RETRIEVAL_SERVICE_URL=
INTERNAL_API_KEY=
